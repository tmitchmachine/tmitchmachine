    /* Lightweight page-local styling for the media grid */
    .media-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      min-height: 180px;
      padding: 24px 18px;
      border: 1px solid #e5e5e5;
      border-radius: 8px;
      transition: all 0.2s ease;
      background: #fff;
      text-align: center;
      gap: 8px;
    }

    .media-card:hover {
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
      transform: translateY(-4px);
      text-decoration: none;
    }

    .media-icon {
      font-size: 32px;
      margin-bottom: 12px;
      color: #222;
    }

    .media-card h4 {
      margin: 8px 0;
    }

    .media-logo {
      width: 32px;
      height: 32px;
      margin-bottom: 12px;
      object-fit: contain;
    }
  </style>
